---
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
import Container from "../components/Container.astro";
import HeroSection from "../components/HeroSection.astro";
import FeatureGrid from "../components/FeatureGrid.astro";
import FeatureCard from "../components/FeatureCard.astro";
import { FEATURES } from "../utils/home-content";
import { withBase } from "../utils/paths";
---

<Layout
  title="GymLog — Registre treinos e acompanhe sua evolução física"
  description="O GymLog ajuda você a registrar treinos, acompanhar sua evolução física e organizar seus ciclos de treino — rápido, intuitivo e 100% offline."
  ogImage={withBase("/images/og-home.png")}
  ogImageAlt="GymLog — aplicativo para registrar treinos e acompanhar sua evolução física"
>
  <HeroSection />

  <Section ariaLabel="Recursos do GymLog" tight>
    <Container>
      <h2 class="section-title">Feito para quem treina de verdade</h2>
      <FeatureGrid>
        {
          FEATURES.map((feature) => (
            <FeatureCard
              icon={feature.icon}
              title={feature.title}
              description={feature.description}
            />
          ))
        }
      </FeatureGrid>
    </Container>
  </Section>
</Layout>

<style>
  .section-title {
    font-size: var(--font-size-3xl);
    margin-bottom: var(--space-xl);
  }
</style>
