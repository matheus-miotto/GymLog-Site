---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE } from "../utils/site";
import { withBase } from "../utils/paths";
import "../styles/theme.css";
import "../styles/global.css";

/**
 * Layout principal do site institucional.
 * Todas as páginas devem reutilizar este layout, informando ao menos
 * `title` e `description` para SEO e Open Graph.
 */
interface Props {
  title: string;
  description: string;
  /** Caminho para uma imagem 1200×630 (convenção do projeto). */
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: "website" | "article";
}

const {
  title,
  description,
  ogImage,
  ogImageAlt,
  ogType = "website",
} = Astro.props;

// Páginas que já compõem o próprio título com o nome do site (ex.: a Home)
// não recebem o sufixo " · GymLog" duplicado.
const pageTitle = title.startsWith(SITE.name)
  ? title
  : `${title} · ${SITE.name}`;
// Astro.url.pathname já reflete o `base` configurado (ex.: /GymLog-Site/...),
// então basta combiná-lo com Astro.site para obter a URL pública final.
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? SITE.url);
// `ogImage` chega como caminho absoluto ("/images/x.png") já prefixado
// com o base pelas páginas (via `withBase`), então também pode ser
// resolvido diretamente contra Astro.site.
const ogImageURL = ogImage
  ? new URL(ogImage, Astro.site ?? SITE.url)
  : undefined;
---

<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <link rel="icon" href={withBase("/favicon.ico")} />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="pt_BR" />
    {
      ogImageURL && (
        <>
          <meta property="og:image" content={ogImageURL} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          {ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
        </>
      )
    }

    <!-- Twitter Card -->
    <meta
      name="twitter:card"
      content={ogImageURL ? "summary_large_image" : "summary"}
    />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {ogImageURL && <meta name="twitter:image" content={ogImageURL} />}
    {
      ogImageURL && ogImageAlt && (
        <meta name="twitter:image:alt" content={ogImageAlt} />
      )
    }
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
