---
/**
 * Grid responsivo para organizar FeatureCard, sem breakpoints manuais:
 * as colunas se ajustam automaticamente à largura disponível.
 */
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<div class:list={["feature-grid", { "feature-grid--compact": compact }]}>
  <slot />
</div>

<style>
  .feature-grid {
    display: grid;
    gap: var(--space-lg);
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }

  .feature-grid--compact {
    gap: var(--space-md);
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }
</style>
