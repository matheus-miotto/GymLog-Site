---
/**
 * Grid responsivo para organizar FeatureCard, sem breakpoints manuais:
 * as colunas se ajustam automaticamente à largura disponível.
 */
---

<div class="feature-grid">
  <slot />
</div>

<style>
  .feature-grid {
    display: grid;
    gap: var(--space-lg);
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }
</style>
