---
import { withBase } from "../utils/paths";

interface Props {
  size?: "sm" | "lg";
  iconOnly?: boolean;
}

const { size = "sm", iconOnly = false } = Astro.props;

const sLogo = withBase("/images/logo/logo.png"); // ou logo.png
---

<span class:list={["logo", `logo--${size}`]}>
  <img
    class="logo__mark"
    src={sLogo}
    alt="GymLog"
    loading="eager"
    decoding="async"
  />

  {!iconOnly && <span class="logo__word">GymLog</span>}
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    color: var(--color-text-primary);
  }

  .logo__mark {
    flex-shrink: 0;
    object-fit: contain;
    display: block;
  }

  .logo__word {
    font-weight: var(--font-weight-bold);
    line-height: 1;
    color: inherit;
  }

  .logo--sm .logo__mark {
    width: 22px;
    height: 22px;
  }

  .logo--sm .logo__word {
    font-size: var(--font-size-lg);
  }

  .logo--lg .logo__mark {
    width: 48px;
    height: 48px;
  }

  .logo--lg .logo__word {
    font-size: var(--font-size-2xl);
  }
</style>