---
import Icon from "./Icon.astro";
import type { IconName } from "../utils/icons";

/**
 * Card de recurso: ícone + título + descrição opcional.
 * `compact` organiza o conteúdo em linha, em vez de card vertical
 * (usado na seção "Em desenvolvimento").
 * `upcoming` aplica um tratamento visual mais discreto (borda tracejada,
 * ícone neutro) para deixar claro que o recurso ainda não está disponível.
 */
interface Props {
  icon: IconName;
  title: string;
  description?: string;
  compact?: boolean;
  upcoming?: boolean;
}

const {
  icon,
  title,
  description,
  compact = false,
  upcoming = false,
} = Astro.props;
---

<div
  class:list={[
    "feature-card",
    { "feature-card--compact": compact, "feature-card--upcoming": upcoming },
  ]}
>
  <div class="feature-card__icon">
    <Icon name={icon} size={compact ? 20 : 28} />
  </div>
  <h3 class="feature-card__title">{title}</h3>
  {description && <p class="feature-card__description">{description}</p>}
</div>

<style>
  .feature-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    padding: var(--space-lg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background-color: var(--color-surface);
  }

  .feature-card:hover {
    border-color: var(--color-text-muted);
  }

  .feature-card__icon {
    color: var(--color-primary);
    margin-bottom: var(--space-2xs);
  }

  .feature-card__title {
    font-size: var(--font-size-base);
    margin: 0;
  }

  .feature-card__description {
    font-size: var(--font-size-sm);
    margin: 0;
  }

  .feature-card--compact {
    flex-direction: row;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-md);
  }

  .feature-card--compact .feature-card__icon {
    margin-bottom: 0;
  }

  .feature-card--compact .feature-card__title {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
  }

  .feature-card--upcoming {
    border-style: dashed;
    background-color: transparent;
  }

  .feature-card--upcoming:hover {
    border-color: var(--color-text-muted);
  }

  .feature-card--upcoming .feature-card__icon {
    color: var(--color-text-muted);
  }

  .feature-card--upcoming .feature-card__title {
    color: var(--color-text-secondary);
  }
</style>
