---
/**
 * Selo "em breve" para as lojas de aplicativo. Renderizado como botão
 * desabilitado, pois ainda não há link real de destino (ver ROADMAP).
 */
interface Props {
  store: "App Store" | "Google Play";
}

const { store } = Astro.props;
---

<button
  type="button"
  class="store-badge"
  disabled
  aria-label={`Em breve na ${store}`}
>
  <span class="store-badge__eyebrow">Em breve</span>
  <span class="store-badge__store">{store}</span>
</button>

<style>
  .store-badge {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
    padding: var(--space-2xs) var(--space-md);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background-color: var(--color-surface);
    color: var(--color-text-primary);
    font-family: var(--font-family-base);
    cursor: default;
  }

  .store-badge__eyebrow {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
  }

  .store-badge__store {
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-medium);
  }
</style>
