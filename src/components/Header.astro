---
import Container from "./Container.astro";
import Icon from "./Icon.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { withBase } from "../utils/paths";

const { pathname } = Astro.url;

/**
 * Links de navegação principal. Adicionar novas páginas aqui
 * automaticamente as inclui no Header (desktop e mobile).
 */
const links = [
  { href: "/", label: "Início" },
  { href: "/privacy", label: "Política" },
  { href: "/terms", label: "Termos" },
  { href: "/support", label: "Suporte" },
];
---

<header class="header">
  <Container as="div">
    <div class="header__inner">
      <a href={withBase("/")} class="header__logo">GymLog</a>

      {/*
        header__end agrupa nav + controles à direita. O checkbox do menu
        mobile ("checkbox hack": alterna via CSS, sem JavaScript) precisa
        ficar antes de header__nav no HTML para o seletor `~` funcionar —
        a ordem visual (nav, ThemeToggle, hambúrguer) é só CSS (o checkbox
        fica oculto e o restante segue a ordem natural do HTML).
      */}
      <div class="header__end">
        <input
          type="checkbox"
          id="nav-toggle"
          class="header__toggle-input"
          aria-controls="primary-navigation"
        />

        <nav
          class="header__nav"
          id="primary-navigation"
          aria-label="Navegação principal"
        >
          {
            links.map((link) => (
              <a
                href={withBase(link.href)}
                aria-current={
                  pathname === withBase(link.href) ? "page" : undefined
                }
              >
                {link.label}
              </a>
            ))
          }
        </nav>

        <ThemeToggle />

        <label
          for="nav-toggle"
          class="header__toggle-label"
          aria-label="Abrir menu de navegação"
        >
          <span class="header__toggle-icon header__toggle-icon--menu">
            <Icon name="menu" size={22} />
          </span>
          <span class="header__toggle-icon header__toggle-icon--close">
            <Icon name="x" size={22} />
          </span>
        </label>
      </div>
    </div>
  </Container>
</header>

<style>
  .header {
    border-bottom: 1px solid var(--color-border);
    background-color: var(--color-header);
    transition:
      background-color var(--transition-base),
      border-color var(--transition-base);
  }

  .header__inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: var(--space-sm);
  }

  .header__logo {
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    transition: color var(--transition-base);
  }

  .header__logo:hover {
    color: var(--color-primary);
  }

  .header__end {
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }

  /* Checkbox visualmente oculto, mas mantido acessível (foco/leitor de tela) */
  .header__toggle-input {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .header__toggle-label {
    display: none;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    color: var(--color-text-primary);
    cursor: pointer;
    transition: color var(--transition-base);
  }

  .header__toggle-input:focus-visible ~ .header__toggle-label {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }

  .header__toggle-icon--close {
    display: none;
  }

  .header__toggle-input:checked ~ .header__toggle-label .header__toggle-icon--menu {
    display: none;
  }

  .header__toggle-input:checked ~ .header__toggle-label .header__toggle-icon--close {
    display: inline-flex;
  }

  .header__nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
  }

  .header__nav a {
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
    transition: color var(--transition-base);
  }

  .header__nav a:hover,
  .header__nav a[aria-current="page"] {
    color: var(--color-primary);
  }

  @media (max-width: 767px) {
    .header__toggle-label {
      display: inline-flex;
    }

    .header__nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-sm);
      padding: var(--space-md);
      background-color: var(--color-header);
      border-bottom: 1px solid var(--color-border);
    }

    .header__toggle-input:checked ~ .header__nav {
      display: flex;
    }

    .header__nav a {
      width: 100%;
    }
  }
</style>
