---
/**
 * Seção genérica com espaçamento vertical padronizado.
 * Usada para compor as páginas em blocos consistentes.
 */
interface Props {
  id?: string;
  ariaLabel?: string;
  /**
   * Reduz o espaçamento superior — usar quando a seção anterior já
   * termina com respiro suficiente, para evitar dois paddings somados
   * criando um vão maior do que o resto do ritmo vertical da página.
   */
  tight?: boolean;
}

const { id, ariaLabel, tight = false } = Astro.props;
---

<section id={id} aria-label={ariaLabel} class:list={["section", { "section--tight": tight }]}>
  <slot />
</section>

<style>
  .section {
    padding-block: var(--space-3xl);
  }

  .section--tight {
    padding-block-start: var(--space-xl);
  }

  @media (max-width: 640px) {
    .section {
      padding-block: var(--space-xl);
    }

    .section--tight {
      padding-block-start: var(--space-lg);
    }
  }
</style>
