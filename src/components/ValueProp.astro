---
import Icon from "./Icon.astro";
import type { IconName } from "../utils/icons";

/**
 * Item da seção "Por que escolher o GymLog?": ícone + título + uma frase
 * curta que transmite a filosofia do produto, não apenas a funcionalidade.
 */
interface Props {
  icon: IconName;
  title: string;
  description: string;
}

const { icon, title, description } = Astro.props;
---

<div class="value-prop">
  <div class="value-prop__icon">
    <Icon name={icon} size={22} />
  </div>
  <div class="value-prop__body">
    <h3 class="value-prop__title">{title}</h3>
    <p class="value-prop__description">{description}</p>
  </div>
</div>

<style>
  .value-prop {
    display: flex;
    align-items: flex-start;
    gap: var(--space-sm);
    padding: var(--space-md);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background-color: var(--color-surface);
    transition:
      border-color var(--transition-base),
      box-shadow var(--transition-base);
  }

  .value-prop:hover {
    border-color: var(--color-primary);
    box-shadow: var(--shadow-sm);
  }

  .value-prop__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-md);
    background-color: var(--color-bg-elevated);
    color: var(--color-primary);
  }

  .value-prop__title {
    font-size: var(--font-size-base);
    margin: 0 0 var(--space-3xs);
  }

  .value-prop__description {
    font-size: var(--font-size-sm);
    margin: 0;
  }
</style>
